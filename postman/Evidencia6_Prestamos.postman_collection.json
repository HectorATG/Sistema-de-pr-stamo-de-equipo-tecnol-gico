                  "pm.test(\"HTTP 200 | El catálogo incluye el equipo 1 y solo muestra equipos disponibles\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const equipos = pm.response.json();",
                  "  pm.expect(equipos.some(equipo => equipo.id === 1)).to.equal(true);",
                  "  pm.expect(equipos.every(equipo => equipo.estado === 'DISPONIBLE')).to.equal(true);",
                  "});"
