            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipoId\": 1,\n  \"fechaInicio\": \"2026-11-12\",\n  \"fechaFin\": \"2026-11-14\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 | Se registra la solicitud de Ana con sus fechas\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  const solicitud = JSON.parse(pm.request.body.raw);",
                  "  pm.expect(pm.response.json()).to.include({",
                  "    id: 1, solicitanteUsername: 'ana', estado: 'SOLICITADO',",
